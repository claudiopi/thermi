{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr merge *)"
    ],
    "deny": [
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push*+*)",
      "Bash(*--admin*)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push* -f*)",
      "PowerShell(git push*+*)",
      "PowerShell(*--admin*)"
    ]
  }
}
