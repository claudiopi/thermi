<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests that need Linux: the sensor service on recorded trees, its socket, and thermi against compositors of the
       tests' own. Core's behavior is tested in Thermi.Tests. Plain net10.0, marked for Linux in Program.cs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Program.cs is xunit's entry point and the program a test's session starts to read through the SDK. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Thermi.Tests.Shared" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- What the Linux and macOS tests share, from tests/Shared, and the one check of the contract's schemas, which
       Thermi.Tests holds. -->
  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Compile Include="..\Thermi.Tests\Contract\SchemaCheck.cs" Link="Contract\SchemaCheck.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Thermi.Client\Thermi.Client.csproj" />
    <ProjectReference Include="..\..\src\Thermi.Core\Thermi.Core.csproj" />
    <ProjectReference Include="..\..\src\Thermi.Linux\Thermi.Linux.csproj" />
    <ProjectReference Include="..\..\src\Thermi.Sensors.Linux\Thermi.Sensors.Linux.csproj" />
  </ItemGroup>

</Project>
