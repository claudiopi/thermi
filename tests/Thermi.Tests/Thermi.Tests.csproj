<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Thermi.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- The Windows tests' reading of a recording, shared rather than copied. -->
  <ItemGroup>
    <Compile Include="..\Thermi.Windows.Tests\TestRecordings.cs" Link="Shared\TestRecordings.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Recordings\*.json;Recordings\*.jsonl;Configs\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Thermi.Core\Thermi.Core.csproj" />
    <ProjectReference Include="..\..\src\Thermi.Client\Thermi.Client.csproj" />
  </ItemGroup>

</Project>
