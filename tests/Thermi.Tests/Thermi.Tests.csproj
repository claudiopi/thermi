<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Thermi.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- The Windows tests' reading of a recording, their settings folder and their log, shared rather than copied. -->
  <ItemGroup>
    <Compile Include="..\Thermi.Windows.Tests\TestRecordings.cs" Link="Shared\TestRecordings.cs" />
    <Compile Include="..\Thermi.Windows.Tests\SettingsFolder.cs" Link="Shared\SettingsFolder.cs" />
    <Compile Include="..\Thermi.Windows.Tests\ListLogger.cs" Link="Shared\ListLogger.cs" />
  </ItemGroup>

  <!-- What the macOS tests' plain session may start, which the repo's rules ask on every OS, as only a Mac runs those tests. -->
  <ItemGroup>
    <Compile Include="..\Thermi.MacOS.Tests\PlainSession.cs" Link="Rules\PlainSession.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Recordings\*.json;Recordings\Trees\*.json;Recordings\*.jsonl;Configs\*.json;Golden\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Thermi.App\Thermi.App.csproj" />
    <ProjectReference Include="..\..\src\Thermi.Cli\Thermi.Cli.csproj" />
    <ProjectReference Include="..\..\src\Thermi.Core\Thermi.Core.csproj" />
    <ProjectReference Include="..\..\src\Thermi.Client\Thermi.Client.csproj" />
    <ProjectReference Include="..\..\src\Thermi.Releases\Thermi.Releases.csproj" />
  </ItemGroup>

</Project>
