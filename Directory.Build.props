<Project>

  <!-- Build policy for every project. Every warning is an error, from the first commit:
       analyzers turned on later become baselines that never go away.
       Companions: Directory.Packages.props (versions), Thermi.globalconfig (severities, and why
       each disabled rule is off), SonarLint.xml (size limits), BannedSymbols.txt (banned APIs). -->

  <PropertyGroup>
    <!-- thermi's one version, which About and both executables' file properties show; a v1 preview until 1.0. Without
         the commit after a "+", so the two show the same. -->
    <Version>0.9.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- IDE0005 (unused usings) only runs in build with this on. XML docs stay optional (CS1591 off). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Pinned, not "latest": an SDK update must not add errors on its own. -->
    <AnalysisLevel>10-recommended</AnalysisLevel>

    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Packages' own messages, such as System.CommandLine's help, only in English: thermi's command line is for
         people and agents setting it up, and a folder per language would ship for its help alone. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- C#'s analyzers, for C# alone: the installer is a WiX project. -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- Where the service checks for updates and the public keys it trusts (docs/adr/0008-updates.md): a build without them
       never updates itself. A release build names the SHA-256 thumbprints of the certificates, separated by semicolons, one
       of which must sign every version's catalog. The release workflow gives the real ones; scripts/install.ps1
       -UpdatesFrom a test channel's, with no signer. -->
  <ItemGroup Condition="'$(ThermiUpdatesFrom)' != ''">
    <AssemblyMetadata Include="ThermiUpdatesFrom" Value="$(ThermiUpdatesFrom)" />
    <AssemblyMetadata Include="ThermiUpdatesKey" Value="$(ThermiUpdatesKey)" />
    <AssemblyMetadata Include="ThermiUpdatesBackupKey" Value="$(ThermiUpdatesBackupKey)" />
    <AssemblyMetadata Include="ThermiUpdatesSigners" Value="$(ThermiUpdatesSigners)" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Visible="false" />
    <!-- Sonar reads its limits only from this file; limits in .editorconfig are ignored. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)SonarLint.xml" Visible="false" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)Thermi.globalconfig" />
  </ItemGroup>

  <!-- WebView2's package references its WPF and Windows Forms controls in every project that reaches it; thermi hosts its
       Core controller in a window of its own and builds on neither, so no project references them. -->
  <Target Name="DropWebView2Controls" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

</Project>
