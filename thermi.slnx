<Solution>
  <Folder Name="/src/">
    <Project Path="src/Thermi.Core/Thermi.Core.csproj" />
    <Project Path="src/Thermi.App/Thermi.App.csproj" />
    <Project Path="src/Thermi.Cli/Thermi.Cli.csproj" />
    <Project Path="src/Thermi.Windows/Thermi.Windows.csproj" />
    <Project Path="src/Thermi.Releases/Thermi.Releases.csproj" />
    <Project Path="src/Thermi.Sensors.Windows/Thermi.Sensors.Windows.csproj" />
    <Project Path="src/Thermi.Settings.Types/Thermi.Settings.Types.csproj" />
    <Project Path="src/Thermi.Client/Thermi.Client.csproj" />
    <Project Path="src/Thermi.Trust/Thermi.Trust.csproj" />
    <Project Path="src/Thermi.Linux/Thermi.Linux.csproj" />
    <Project Path="src/Thermi.Sensors.Linux/Thermi.Sensors.Linux.csproj" />
  </Folder>
  <!-- The GNOME Shell extension is JavaScript the Shell loads as it is, so it is here as its files. -->
  <Folder Name="/src/Thermi.Gnome/">
    <File Path="src/Thermi.Gnome/extension.js" />
    <File Path="src/Thermi.Gnome/metadata.json" />
    <File Path="src/Thermi.Gnome/README.md" />
  </Folder>
  <!-- The MSI needs a published version first and WiX's Visual Studio extension to load, so it is here as its files;
       scripts/updates.ps1 builds it. -->
  <Folder Name="/src/Thermi.Installer/">
    <File Path="src/Thermi.Installer/Package.wxs" />
    <File Path="src/Thermi.Installer/README.md" />
    <File Path="src/Thermi.Installer/Thermi.Installer.wixproj" />
  </Folder>
  <!-- The settings page is an npm project, which the .NET build of Thermi.Windows builds; its top files are here, and
       src/Thermi.Settings.Web/README.md maps its folders. -->
  <Folder Name="/src/Thermi.Settings.Web/">
    <File Path="src/Thermi.Settings.Web/.gitignore" />
    <File Path="src/Thermi.Settings.Web/.npmrc" />
    <File Path="src/Thermi.Settings.Web/eslint.config.js" />
    <File Path="src/Thermi.Settings.Web/index.html" />
    <File Path="src/Thermi.Settings.Web/knip.jsonc" />
    <File Path="src/Thermi.Settings.Web/package.json" />
    <File Path="src/Thermi.Settings.Web/playwright.config.ts" />
    <File Path="src/Thermi.Settings.Web/README.md" />
    <File Path="src/Thermi.Settings.Web/stryker.config.json" />
    <File Path="src/Thermi.Settings.Web/tsconfig.json" />
    <File Path="src/Thermi.Settings.Web/vite.config.ts" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Thermi.Tests/Thermi.Tests.csproj" />
    <Project Path="tests/Thermi.Windows.Tests/Thermi.Windows.Tests.csproj" />
    <Project Path="tests/Thermi.Linux.Tests/Thermi.Linux.Tests.csproj" />
  </Folder>
</Solution>
