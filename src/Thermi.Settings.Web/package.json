{
  "name": "thermi-settings-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --dir src --passWithNoTests",
    "doctor": "npx --no-install react-doctor --blocking warning",
    "deadcode": "knip",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@fluentui/react-components": "9.75.2",
    "@fluentui/react-icons": "2.0.347",
    "@fluentui/react-motion": "9.16.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.48.0",
    "react-doctor": "0.9.23",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "11.0.9",
      "typed-rest-client": {
        "qs": "6.17.1"
      }
    }
  }
}
