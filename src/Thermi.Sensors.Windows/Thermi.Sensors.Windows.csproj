<Project Sdk="Microsoft.NET.Sdk">

  <!-- The elevated sensor host: the only process with admin rights. See docs/adr/0003-sensor-service.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>thermi-sensors</AssemblyName>
    <RootNamespace>Thermi.Sensors.Windows</RootNamespace>
    <!-- Published for the PC's processor, its code compiled ahead so it starts without the JIT (scripts/install.ps1);
         both processors are restored, so the lock file holds what a publish for either needs. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <!-- CsWin32's generated Win32 calls need it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- .NET 10's oldest Windows, 10 1607, as for Thermi.Windows.csproj: said in Program.cs, since the windows TFM stops at
         7.0, so no call needs a guard for an older one. -->
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thermi.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
    <ProjectReference Include="..\Thermi.Trust\Thermi.Trust.csproj" />
  </ItemGroup>

  <Import Project="..\Launchers.targets" />

</Project>
