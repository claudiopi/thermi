<Project Sdk="Microsoft.NET.Sdk">

  <!-- What thermi trusts on Windows before it runs or changes anything as SYSTEM: the overlay's driver install and the
       service's updates both ask it. See docs/adr/0008-updates.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Thermi.Trust</RootNamespace>
    <!-- CsWin32's generated Win32 calls need it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

</Project>
