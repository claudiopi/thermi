<Project Sdk="Microsoft.NET.Sdk">

  <!-- The overlay app. Runs as the user, never elevated. See docs/adr/0001-architecture.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>thermi</AssemblyName>
    <RootNamespace>Thermi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- thermi's mark, drawn by scripts/mark-icon.ps1; the settings window takes it from the executable too. -->
    <ApplicationIcon>thermi.ico</ApplicationIcon>
    <!-- CsWin32's generated Win32 calls need it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The Win32 declarations are generated for 64-bit layouts: Windows 11 runs thermi only as x64 or Arm64, whose
         structures match, and some, like the tray's NOTIFYICONDATAW, have no layout for every CPU at once. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
    <!-- .NET 10's oldest Windows, 10 1607, which has every Win32 call thermi makes: said in Program.cs, since the
         windows TFM stops at 7.0 without the Windows SDK's WinRT projection, which thermi does not use. -->
    <GenerateSupportedOSPlatformAttribute>false</GenerateSupportedOSPlatformAttribute>
    <!-- Published for the PC's processor, its code compiled ahead so it starts without the JIT (scripts/install.ps1);
         both processors are restored, so the lock file holds what a publish for either needs. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <!-- Profiling the hot code of a program that wakes once a second costs more than it gains: without it, the overlay's
         first minute and the window's measured about half as much CPU, and no more once settled. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thermi.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
  </ItemGroup>

  <!-- GDI+, which paints the overlay and the tray, from the Windows Desktop runtime the installer already needs: its
       Windows Forms profile, the smallest that holds System.Drawing.Common, and no WPF. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <Import Project="SettingsPage.targets" />

</Project>
