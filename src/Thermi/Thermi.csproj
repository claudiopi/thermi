<Project Sdk="Microsoft.NET.Sdk">

  <!-- The overlay app. Runs as the user, never elevated. See docs/adr/0001-architecture.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>thermi</AssemblyName>
    <RootNamespace>Thermi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- LibraryImport and the window procedure pointer need it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thermi.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
  </ItemGroup>

</Project>
