<Project>

  <!-- The settings window's page (docs/adr/0007-settings-window-in-webview2-and-react.md): before thermi's resources are
       made, the bridge's TypeScript and the agents' JSON Schemas (docs/agents/README.md) are written from Core, the web app is installed when its lockfile changed and built
       when anything it builds from changed, and its dist is embedded, served to WebView2 from a virtual host. The
       web build type-checks the page against what was just written, so a change that breaks the bridge fails here.
       Needs Node 22.12 or later; npm installs with the lockfile, never running a package's scripts. -->

  <PropertyGroup>
    <SettingsWeb>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Thermi.Settings.Web'))\</SettingsWeb>
    <SettingsTypes>$(MSBuildThisFileDirectory)..\Thermi.Settings.Types\Thermi.Settings.Types.csproj</SettingsTypes>
    <AgentSchemas>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../docs/agents/schema'))</AgentSchemas>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</DotnetHost>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</DotnetHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built first and run, never referenced: thermi.exe holds none of its code. -->
    <ProjectReference Include="$(SettingsTypes)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="WriteBridgeTypes" BeforeTargets="PrepareResources" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(SettingsTypes)" Targets="GetTargetPath" RemoveProperties="RuntimeIdentifier;SelfContained;PublishReadyToRun;TargetFramework">
      <Output TaskParameter="TargetOutputs" PropertyName="SettingsTypesPath" />
    </MSBuild>
    <Exec Command="&quot;$(DotnetHost)&quot; exec &quot;$(SettingsTypesPath)&quot; &quot;$(SettingsWeb)src\bridge&quot; &quot;$(AgentSchemas)&quot;" />
  </Target>

  <Target Name="InstallSettingsWeb" AfterTargets="WriteBridgeTypes" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(SettingsWeb)package-lock.json" Outputs="$(SettingsWeb)node_modules\.package-lock.json">
    <Exec Command="npm ci --ignore-scripts --no-audit --no-fund" WorkingDirectory="$(SettingsWeb)" />
  </Target>

  <Target Name="BuildSettingsWeb" AfterTargets="InstallSettingsWeb" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(SettingsWebInput)" Outputs="$(SettingsWeb)dist\index.html" DependsOnTargets="FindSettingsWebInputs">
    <Exec Command="npm run build" WorkingDirectory="$(SettingsWeb)" />
  </Target>

  <Target Name="FindSettingsWebInputs">
    <ItemGroup>
      <SettingsWebInput Include="$(SettingsWeb)src\**\*;$(SettingsWeb)tests\**\*.ts;$(SettingsWeb)index.html;$(SettingsWeb)*.json;$(SettingsWeb)*.ts;$(SettingsWeb)node_modules\.package-lock.json" />
    </ItemGroup>
  </Target>

  <Target Name="EmbedSettingsWeb" AfterTargets="BuildSettingsWeb" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <SettingsWebFile Include="$(SettingsWeb)dist\**\*" />
      <EmbeddedResource Include="@(SettingsWebFile)" LogicalName="web/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" WithCulture="false" Type="Non-Resx" />
    </ItemGroup>
  </Target>

</Project>
