# thermi's sensors (docs/adr/0019-linux.md): started by thermi-sensors.socket, ended by itself 10 s after its last client
# left. It runs as a user of its own, with no capability, and reads only the kernel's files, which any user may read,
# the energy counters, which 60-thermi-sensors.rules lets its group read, and NVIDIA's devices through NVML.
[Unit]
Description=thermi's sensors
Documentation=https://github.com/claudiopi/thermi
Requires=thermi-sensors.socket
After=thermi-sensors.socket

[Service]
ExecStart=/usr/lib/thermi/thermi-sensors
User=thermi
Group=thermi
Restart=on-failure
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

# It writes nothing: its socket is systemd's, and it logs to the journal.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RemoveIPC=yes

# NVIDIA's devices, nvidiactl among them, are the only ones NVML opens; a PC without them has none to allow.
DevicePolicy=closed
DeviceAllow=char-nvidia-frontend rw

# A datagram socket that sends nothing finds the local address its default route goes out from; nothing is let out.
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateUsers=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
