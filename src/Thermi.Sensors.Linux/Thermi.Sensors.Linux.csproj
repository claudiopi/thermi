<Project Sdk="Microsoft.NET.Sdk">

  <!-- thermi-sensors on Linux: a systemd service as its own user, started by its socket (docs/adr/0019-linux.md). Plain
       net10.0, marked for Linux in Program.cs, as the shared projects are plain net10.0 for any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>thermi-sensors</AssemblyName>
    <RootNamespace>Thermi.Sensors.Linux</RootNamespace>
    <!-- Published self-contained for the PC's processor into the packages; both are restored, so the lock file holds what a
         publish for either needs. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- It formats nothing for a person, so it needs no ICU, which a server or a container may not have. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NVML's calls, generated by LibraryImport. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thermi.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
  </ItemGroup>

</Project>
