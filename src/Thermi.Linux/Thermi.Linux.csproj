<Project Sdk="Microsoft.NET.Sdk">

  <!-- thermi on Linux, as the person: the overlay, the settings window in WebKitGTK and thermi-cli
       (docs/adr/0019-linux.md). Plain net10.0, marked for Linux in Program.cs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>thermi</AssemblyName>
    <RootNamespace>Thermi.Linux</RootNamespace>
    <!-- Published self-contained for the PC's processor into the packages; both are restored, so the lock file holds what a
         publish for either needs. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thermi.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Gdk-4.0" />
    <PackageReference Include="GirCore.Gio-2.0" />
    <PackageReference Include="GirCore.PangoCairo-1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.App\Thermi.App.csproj" />
    <ProjectReference Include="..\Thermi.Cli\Thermi.Cli.csproj" />
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
  </ItemGroup>

  <Import Project="..\ThermiCli.targets" />

</Project>
