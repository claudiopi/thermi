<Project Sdk="Microsoft.NET.Sdk">

  <!-- thermi on Linux, as the person: the overlay, the settings window in WebKitGTK and thermi-cli
       (docs/adr/0019-linux.md). Plain net10.0, marked for Linux in Program.cs. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>thermi</AssemblyName>
    <RootNamespace>Thermi.Linux</RootNamespace>
    <!-- Published self-contained for the PC's processor into the packages; both are restored, so the lock file holds what a
         publish for either needs. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thermi.Linux.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GirCore.Gio-2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.App\Thermi.App.csproj" />
    <ProjectReference Include="..\Thermi.Cli\Thermi.Cli.csproj" />
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
  </ItemGroup>

  <!-- thermi-cli: a second apphost of thermi.dll, which runs the agents' commands alone, as Windows' does
       (docs/adr/0013-agents-cli-and-mcp.md). It goes wherever thermi goes: the build's output, a referencing project's and
       the publish folder. -->
  <Target Name="ThermiCliFiles" BeforeTargets="AssignTargetPaths" DependsOnTargets="_GetAppHostPaths" Condition="'$(AppHostSourcePath)' != ''">
    <PropertyGroup>
      <ThermiCliPath>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)cli/thermi-cli'))</ThermiCliPath>
    </PropertyGroup>
    <ItemGroup>
      <None Include="$(ThermiCliPath)" Link="thermi-cli" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <UsingTask TaskName="CreateAppHost" AssemblyFile="$(MicrosoftNETBuildTasksAssembly)" />
  <Target Name="ThermiCliAppHost" AfterTargets="_CreateAppHost" BeforeTargets="CopyFilesToOutputDirectory" DependsOnTargets="ThermiCliFiles"
          Inputs="@(IntermediateAssembly);$(AppHostSourcePath)" Outputs="$(ThermiCliPath)" Condition="'$(AppHostSourcePath)' != ''">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(ThermiCliPath)'))" />
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(ThermiCliPath)"
                   AppBinaryName="$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="false"
                   Retries="$(CopyRetryCount)"
                   RetryDelayMilliseconds="$(CopyRetryDelayMilliseconds)" />
  </Target>

</Project>
