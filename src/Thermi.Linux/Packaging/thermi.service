# thermi's overlay, as the person, in their graphical session alone (docs/adr/0019-linux.md). The package installs it as
# a user unit; each person's own link, which thermi's first start makes, starts it at sign-in. "Exit thermi" ends it
# with 0, as SIGTERM does, which leaves it stopped until the next sign-in; a crash or SIGKILL starts it again, a few
# times a minute at most. A desktop it cannot show on ends it with 6, which starts nothing again, as each start would
# find the same. A system user's session, as a login screen's, never runs it.
[Unit]
Description=thermi, the hardware monitor's overlay
Documentation=https://github.com/claudiopi/thermi
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
ConditionUser=!@system
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/thermi
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=6
# After a package changed thermi's files, the overlay ends with 75 at a quiet moment and starts again from them: a
# hand-over, no failure.
SuccessExitStatus=75
RestartForceExitStatus=75
# A loop that hangs, painting nothing and answering no one, misses the second its watchdog hears, and the overlay is
# killed and started again, as a crash is.
WatchdogSec=30
NotifyAccess=main
Slice=app.slice

[Install]
WantedBy=graphical-session.target
