# thermi's overlay, as the person, in their graphical session (docs/adr/0019-linux.md). The package installs it as a
# user unit and never enables it for every user: each person's own setting does. "Exit thermi" ends it with 0, which,
# as a SIGTERM, leaves it stopped until the next sign-in; a crash or another signal, as SIGKILL, starts it again.
[Unit]
Description=thermi, the hardware monitor's overlay
Documentation=https://github.com/claudiopi/thermi
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/thermi
Restart=on-failure
RestartSec=2
Slice=app.slice

[Install]
WantedBy=graphical-session.target
