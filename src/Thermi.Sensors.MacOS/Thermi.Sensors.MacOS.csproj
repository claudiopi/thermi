<Project Sdk="Microsoft.NET.Sdk">

  <!-- thermi-sensors on macOS: a LaunchAgent of the person's, started by its socket (docs/adr/0021-macos.md). Plain net10.0,
       marked for macOS in Program.cs, so it builds and replays its recordings on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>thermi-sensors</AssemblyName>
    <RootNamespace>Thermi.Sensors.MacOS</RootNamespace>
    <!-- Published self-contained for Apple silicon into the app; restored for it, so the lock file holds what that needs. -->
    <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
    <!-- It formats nothing for a person, so it needs no ICU. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- IOKit's, IOReport's and libSystem's calls, generated by LibraryImport, take pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thermi.MacOS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
  </ItemGroup>

</Project>
