<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the overlay and the window decide beyond Core that needs a package or the file system, which any OS's host
       shares (docs/adr/0018-shared-and-windows-projects.md). Plain net10.0, so no Windows type gets in; its types are
       internal, seen only by the hosts and the tests named below. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="thermi" />
    <InternalsVisibleTo Include="thermi-cli" />
    <InternalsVisibleTo Include="Thermi.Cli" />
    <InternalsVisibleTo Include="Thermi.Linux.Tests" />
    <InternalsVisibleTo Include="Thermi.Tests" />
    <InternalsVisibleTo Include="Thermi.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
  </ItemGroup>

</Project>
