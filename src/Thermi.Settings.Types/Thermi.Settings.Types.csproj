<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes the settings window page's TypeScript from Core: the bridge's types and the texts' keys. The .NET build of
       src/Thermi runs it before the web build, so a change on either side of the bridge fails that build. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Thermi.Settings.Types</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Run at build time only, so a publish of thermi for a processor builds it for none. -->
    <IsRidAgnostic>true</IsRidAgnostic>
    <!-- The installer's ReadyToRun restore gives this program a processor too, so the lock file holds both, as
         src/Thermi.Windows's does. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
  </ItemGroup>

</Project>
