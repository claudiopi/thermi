<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- The MSI of one version for one processor (docs/adr/0008-updates.md), built from that version's published folder:
       `pwsh scripts/updates.ps1 pack` builds it, given its MSI option. Outside thermi.slnx, since it needs a publish first. -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>thermi-$(ThermiVersion)-$(Platform)</OutputName>
    <!-- ICE57 reads the Start menu as each person's, but a per-machine package's is everyone's, under ProgramData. -->
    <!-- ICE61 warns of a major upgrade over the same version, which this one makes on purpose: two MSIs of one version, as
         two builds of it, are never installed side by side. -->
    <SuppressIces>ICE57;ICE61</SuppressIces>
    <DefineConstants>Version=$(ThermiMsiVersion);PublishDir=$(ThermiPublishDir)</DefineConstants>
  </PropertyGroup>
</Project>
