<Project Sdk="Microsoft.NET.Sdk">

  <!-- The elevated sensor host: the only process with admin rights. See docs/adr/0003-sensor-service.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>thermi-sensors</AssemblyName>
    <RootNamespace>Thermi.SensorHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Thermi.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thermi.Core\Thermi.Core.csproj" />
  </ItemGroup>

</Project>
