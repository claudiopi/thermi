<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come only from nuget.org, whatever feeds the machine has configured.
     Prevents dependency confusion from a second feed with a package of the same name. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
