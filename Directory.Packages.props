<Project>

  <!-- Every package version lives here. Renovate keeps them current. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.341" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.37.0.15768" />
  </ItemGroup>

  <ItemGroup Label="App">
    <!-- GObject's libraries for .NET, generated from their introspection data: Linux's Cairo, Pango and Gio (docs/adr/0019-linux.md). -->
    <PackageVersion Include="GirCore.Gdk-4.0" Version="0.8.1" />
    <PackageVersion Include="GirCore.PangoCairo-1.0" Version="0.8.1" />
    <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <!-- Pinned exactly: it has not reached 1.0, and a new version may generate other signatures. Build time only. -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="[0.3.371]" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="2.4.0" />
    <PackageVersion Include="System.CommandLine" Version="3.0.0" />
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup Label="Installer">
    <!-- The same release as the WiX SDK in src/Thermi.Installer, whose version its Sdk attribute pins. -->
    <PackageVersion Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
