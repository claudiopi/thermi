# One line ending everywhere: mixed CRLF and LF breaks format checks between machines and CI.
* text=auto eol=crlf

*.png binary
*.ico binary
*.gif binary
*.jpg binary
*.exe binary
*.dll binary
# The pipe's lines as the service writes them, byte for byte, its newlines included.
tests/Thermi.Tests/Golden/*.jsonl binary
# A catalog's files as it hashed them, byte for byte.
tests/Thermi.Windows.Tests/Updates/Catalog/** binary
# The kernel's files as a Linux PC gave them, byte for byte, its newlines included.
tests/Thermi.Tests/Recordings/Trees/** -text
# What Linux reads as it is, systemd's units, udev's rules and sysusers' files among it, which a carriage return breaks.
src/*/Packaging/** text eol=lf
